# syntax=docker/dockerfile:1

# Base image for Potluck - contains all dependencies
# Rebuild only when pyproject.toml or uv.lock changes
# Tags: cpu-<hash> or gpu-<hash> based on dependency hash

ARG GPU=false

# ============================================================================
# Base stage - system dependencies
# ============================================================================
FROM python:3.12-slim AS base

WORKDIR /app

# Install system dependencies including OpenCV requirements
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy only dependency files (changes trigger rebuild)
COPY pyproject.toml uv.lock README.md ./

# Create empty src structure for uv sync (needed for editable install)
RUN mkdir -p src/potluck && touch src/potluck/__init__.py

# ============================================================================
# CPU stage - install torch FIRST from CPU index, then sync remaining deps
# This avoids downloading CUDA torch (which bloats the image)
# ============================================================================
FROM base AS cpu-deps
# Install torch from CPU index first (before uv sync downloads default CUDA version)
RUN uv pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu
# Now sync remaining deps - torch is already satisfied, won't re-download
RUN uv sync --all-extras --frozen
# Clean up cache to minimize image size
RUN rm -rf /root/.cache/uv /root/.cache/pip

# ============================================================================
# GPU stage - install torch FIRST from CUDA index, then sync remaining deps
# ============================================================================
FROM base AS gpu-deps
# Install torch with CUDA 12.4 support first
RUN uv pip install torch torchvision --index-url https://download.pytorch.org/whl/cu124
# Now sync remaining deps - torch is already satisfied
RUN uv sync --all-extras --frozen
# Clean up cache
RUN rm -rf /root/.cache/uv /root/.cache/pip

# ============================================================================
# Stage aliases for GPU selection
# Maps GPU=false -> cpu-deps, GPU=true -> gpu-deps
# ============================================================================
FROM cpu-deps AS deps-false
FROM gpu-deps AS deps-true

# ============================================================================
# Final stage - select based on GPU build arg
# ============================================================================
ARG GPU=false
FROM deps-${GPU} AS final

# Verify installation
RUN uv run python -c "import torch; print(f'PyTorch {torch.__version__}, CUDA available: {torch.cuda.is_available()}')"
